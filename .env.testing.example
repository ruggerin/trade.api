# Copie para .env.testing (gitignorado) e ajuste. As variáveis de conexão/driver de teste
# (DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, SESSION_DRIVER etc.) já vêm do phpunit.xml
# (versionado, sem segredo) — não precisam estar aqui. Só o que o phpunit.xml de propósito não
# define: a senha do Postgres (segredo, nunca comitar) e um APP_KEY (gerado por máquina — sem
# ele, pelo menos 1 teste que usa criptografia falha com MissingAppKeyException). Ver
# phpunit.xml e docs/06-PENDENCIAS.md.
#
# Gere o seu: php artisan key:generate --show
APP_KEY=
DB_PASSWORD=sua_senha_aqui
