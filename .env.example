APP_NAME="Horus API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Postgres é obrigatório — as migrations usam pgcrypto/gen_random_uuid(), específico do
# Postgres (ver docs/01-MODELO-DE-DADOS.md). Depois de configurar as credenciais abaixo, rode
# "php artisan dev:criar-bancos" pra criar pdv_dev e pdv_test automaticamente.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pdv_dev
DB_USERNAME=postgres
DB_PASSWORD=

# Raio de check-in em metros, usado quando a empresa não tem um Parametro próprio
# (CHECKIN_RAIO_METROS) cadastrado — ver docs/02-API-BACKEND.md, regra de negócio 1.
CHECKIN_RAIO_METROS=200

# Dias de antecedência pra gerar OrdemServico de aviso de contrato vencendo, usado quando a
# empresa não tem um Parametro próprio (CONTRATO_AVISO_DIAS) cadastrado — ver
# App\Support\AvisoVencimentoContrato e docs/07-ORDEM-DE-SERVICO.md §5.
CONTRATO_AVISO_DIAS=30

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# DigitalOcean Spaces (S3-compatível, league/flysystem-aws-s3-v3) — disco 's3' em
# config/filesystems.php. AWS_ROOT é a pasta dentro do bucket reservada pra este projeto (o
# bucket pode ser compartilhado entre vários projetos, cada um com a própria pasta). **[IMPLEMENTADO]**
# Preencha e ponha FILESYSTEM_DISK=s3 acima — todo upload privado (foto de perfil, registro de
# visita, anexo de contrato) já usa `config('filesystems.default')` em vez de 'local' cravado,
# então a troca de disco é só isso, nenhum código a mais. Continua privado nos dois casos: sem
# ACL pública, servido sempre pela rota autenticada (nunca a URL direta do bucket).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ROOT=

VITE_APP_NAME="${APP_NAME}"

# --- Docker (docker-compose.yml) --------------------------------------------------------------
# Porta do host pra API — a VPS já roda outras aplicações, troque se 8000 colidir com alguma.
API_PORT=8000
# Roda "php artisan migrate --force --isolated" sozinho a cada boot do container. Desliga se
# preferir aplicar migration manualmente (ex.: primeiro deploy, conferir antes de aplicar).
RUN_MIGRATIONS=true
# Só usados pelo profile facultativo "db" (Postgres containerizado aqui do lado, pra quem ainda
# não tem um) — reaproveita DB_DATABASE/DB_USERNAME/DB_PASSWORD acima. Se você já tem um
# Postgres rodando (caso comum numa VPS existente), ignore esta seção: não use o profile "db",
# e aponte DB_HOST/DB_PORT acima pro Postgres que já existe.

# Rota do dia (docs/48-ROTA-DO-DIA.md) — linha do trajeto seguindo as ruas via Mapbox Map Matching.
# Sem token, a tela mostra a linha reta com aviso de "linha aproximada".
MAPBOX_TOKEN=

# Documentação da API em /docs/api (dedoc/scramble). false = só abre com APP_ENV=local.
API_DOCS_PUBLICA=false

# Push notifications (docs/77 §2.3) — token de acesso da Expo (robô horus-api-push). Vazio = sem push.
EXPO_ACCESS_TOKEN=

# Versão desta API (data + commit), mostrada no app e no admin. Normalmente vem do build da imagem
# (APP_VERSAO=... docker compose up -d --build, ver docker-compose.yml); vazio = "dev".
# APP_VERSAO=

# Licenciamento e antipirataria do app (docs/67-LICENCIAMENTO-E-SESSAO-UNICA.md, config/seguranca.php).
# Versão mínima do app (semver); abaixo dela a API responde 426 e o app pede atualização. Vazio = sem exigência.
APP_VERSAO_MINIMA=
# Fase 3: exige atestação (Play Integrity / App Attest) no login e no refresh. Ligado, o Expo Go
# deixa de entrar — só o build oficial. Indisponibilidade do Google/Apple nunca bloqueia.
ATESTACAO_OBRIGATORIA=false
# Play Integrity: número do projeto no Google Cloud, JSON da conta de serviço e SHA-256 do
# certificado de assinatura do app (Play Console > Integridade do app), em hex.
PLAY_INTEGRITY_PROJETO=
PLAY_INTEGRITY_CREDENCIAIS=
PLAY_INTEGRITY_CERTIFICADO_SHA256=
# App Attest (iOS): Team ID da Apple e ambiente (production | development). A raiz da Apple fica
# em storage/app/private/Apple_App_Attestation_Root_CA.pem (ou APP_ATTEST_RAIZ).
APP_ATTEST_TEAM_ID=
APP_ATTEST_AMBIENTE=production

# Simulador de campo (config/simulador.php, comando dev:simular-atividade) — SÓ servidor de
# teste/demonstração, nunca produção. IDs de empresa por vírgula; vazio = desligado.
SIMULADOR_ATIVIDADE_EMPRESAS=
# E-mails de promotores que ficam de fora da simulação (quem testa o app de verdade).
SIMULADOR_ATIVIDADE_EXCLUIR_EMAILS=

# Sentry (homologação) — docs/70. Deixe o DSN vazio no ambiente local: SDK desligado.
# Em homologação: LOG_STACK=single,sentry_logs e SENTRY_ENABLE_LOGS=true.
SENTRY_LARAVEL_DSN=
# SENTRY_ENVIRONMENT=homologacao   (em homologação; por padrão usa o APP_ENV)
SENTRY_ENABLE_LOGS=false
# Tracing e profiling ficam DESLIGADOS (sem valor aqui). Para ligar: SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_RELEASE=

# Endpoint de saúde (GET /api/saude) pro Uptime Kuma — docs/71. Sem SAUDE_TOKEN só sai o veredito;
# com o token (header X-Saude-Token) sai o detalhe de cada verificação. Gere um valor longo e aleatório.
SAUDE_TOKEN=
